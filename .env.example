# Copia questo file in .env (cp .env.example .env). Il file .env non si versiona.

# Profili di Docker Compose: "ai" avvia anche Ollama; lascia vuoto per avviare senza Ollama
COMPOSE_PROFILES=ai

# Porte sull'host
FRONTEND_PORT=3000
API_PORT=8000
DB_HOST_PORT=3307
MAILPIT_PORT=8025

# MySQL (valori di sviluppo: cambiali fuori dallo sviluppo)
DB_DATABASE=setlist
DB_USERNAME=setlist
DB_PASSWORD=setlist_dev_password
DB_ROOT_PASSWORD=root_dev_password

# Laravel
APP_ENV=local
APP_DEBUG=true
# Se vuota viene generata all'avvio del backend
APP_KEY=
APP_URL=http://localhost:8000
# Origine consentita dal CORS e base dei link nelle email (più origini separate da virgola)
FRONTEND_URL=http://localhost:3000
# Crea i dati dimostrativi al primo avvio (solo se non ci sono utenti)
SEED_ON_START=true

# Email di sviluppo (intercettate da Mailpit)
MAIL_HOST=mailpit
MAIL_PORT=1025

# Frontend: indirizzo dell'API fissato in fase di build (se cambia: docker compose up --build)
VITE_API_URL=http://localhost:8000/api

# Chat AI (Ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=120

# Fallback opzionale su OpenRouter quando Ollama non risponde
AI_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
